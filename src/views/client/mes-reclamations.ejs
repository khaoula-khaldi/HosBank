<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HosBank - Mes réclamations</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-800">

    <%- include("../layouts/client-sidebar") %>

    <main class="ml-64 min-h-screen p-8">

        <div class="max-w-7xl mx-auto">

            <!-- Header -->
            <div class="flex items-center justify-between mb-8">

                <div>
                    <h1 class="text-2xl font-bold text-red-700">
                        Mes réclamations
                    </h1>

                    <p class="text-gray-500 mt-2">
                        Consultez vos réclamations et leur état de traitement.
                    </p>
                </div>

                <a
                    href="/client/reclamations/add"
                    class="px-5 py-3 bg-red-700 text-white rounded-lg font-semibold hover:bg-red-800 transition"
                >
                    + Nouvelle réclamation
                </a>

            </div>

            <!-- Liste -->
            <% if (reclamations && reclamations.length > 0) { %>

                <div class="space-y-5">

                    <% reclamations.forEach(reclamation => { %>

                        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">

                            <div class="flex items-start justify-between gap-6">

                                <div class="flex-1">

                                    <h2 class="text-lg font-semibold text-gray-800 mb-2">
                                        <%= reclamation.sujet %>
                                    </h2>

                                    <p class="text-gray-600 mb-4">
                                        <%= reclamation.description %>
                                    </p>

                                    <p class="text-sm text-gray-400">
                                        Créée le :
                                        <%= new Date(reclamation.date_creation).toLocaleDateString("fr-FR") %>
                                    </p>

                                    <% if (reclamation.date_traitement) { %>

                                        <p class="text-sm text-gray-400 mt-1">
                                            Traitée le :
                                            <%= new Date(reclamation.date_traitement).toLocaleDateString("fr-FR") %>
                                        </p>

                                    <% } %>

                                </div>


                                <div>

                                    <% if (reclamation.statut === "EN_ATTENTE") { %>

                                        <span class="inline-block px-3 py-1 text-sm font-semibold rounded-full bg-yellow-100 text-yellow-700">
                                            En attente
                                        </span>

                                    <% } else if (reclamation.statut === "EN_COURS") { %>

                                        <span class="inline-block px-3 py-1 text-sm font-semibold rounded-full bg-blue-100 text-blue-700">
                                            En cours
                                        </span>

                                    <% } else if (reclamation.statut === "RESOLUE") { %>

                                        <span class="inline-block px-3 py-1 text-sm font-semibold rounded-full bg-green-100 text-green-700">
                                            Résolue
                                        </span>

                                    <% } else if (reclamation.statut === "FERMEE") { %>

                                        <span class="inline-block px-3 py-1 text-sm font-semibold rounded-full bg-gray-100 text-gray-700">
                                            Fermée
                                        </span>

                                    <% } %>

                                </div>

                            </div>

                        </div>

                    <% }) %>

                </div>

            <% } else { %>

                <!-- Empty -->
                <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-10 text-center">

                    <div class="text-5xl mb-4">
                        📩
                    </div>

                    <h2 class="text-lg font-semibold text-gray-800 mb-2">
                        Aucune réclamation
                    </h2>

                    <p class="text-gray-500 mb-6">
                        Vous n'avez encore envoyé aucune réclamation.
                    </p>

                    <a
                        href="/client/reclamations/add"
                        class="inline-block px-5 py-3 bg-red-700 text-white rounded-lg font-semibold hover:bg-red-800 transition"
                    >
                        Créer une réclamation
                    </a>

                </div>

            <% } %>

        </div>

    </main>

</body>

</html>