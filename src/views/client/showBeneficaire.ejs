<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HosBank - Mes bénéficiaires</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-800">

    <!-- Sidebar -->
    <%- include("../layouts/client-sidebar") %>


    <!-- Main -->
    <main class="ml-64 min-h-screen p-8">

        <div class="max-w-7xl mx-auto">

            <!-- Page Header -->
            <div class="flex items-center justify-between mb-8">

                <div>
                    <h2 class="text-2xl font-bold text-red-700 mb-2">
                        My Beneficiaries
                    </h2>

                    <p class="text-gray-500">
                        Manage the beneficiaries registered on your account.
                    </p>
                </div>


                <a
                    href="/client/beneficiaires/add"
                    class="px-5 py-3 bg-red-700 text-white rounded-lg font-semibold hover:bg-red-800 transition"
                >
                    + Add Beneficiary
                </a>

            </div>


            <!-- Beneficiaries List -->
            <% if (beneficiaires && beneficiaires.length > 0) { %>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                    <% beneficiaires.forEach(beneficiaire => { %>

                        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">

                            <h3 class="text-lg font-semibold text-red-700 mb-5">
                                Beneficiary
                            </h3>


                            <div class="border-b border-gray-100 pb-4">

                                <!-- Name -->
                                <div class="mb-3">

                                    <p class="text-sm text-gray-500">
                                        Name
                                    </p>

                                    <p class="font-semibold text-gray-800">
                                        <%= beneficiaire.prenom %>
                                        <%= beneficiaire.nom %>
                                    </p>

                                </div>


                                <!-- Email -->
                                <div class="mb-3">

                                    <p class="text-sm text-gray-500">
                                        Email
                                    </p>

                                    <p class="text-gray-700">
                                        <%= beneficiaire.email %>
                                    </p>

                                </div>


                                <!-- RIB -->
                                <div>

                                    <p class="text-sm text-gray-500">
                                        RIB
                                    </p>

                                    <p class="font-medium text-gray-800">
                                        <%= beneficiaire.rib %>
                                    </p>

                                </div>

                            </div>

                        </div>

                    <% }) %>

                </div>


            <% } else { %>

                <!-- Empty -->
                <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-10 text-center">

                    <div class="text-5xl mb-4">
                        👥
                    </div>

                    <p class="text-gray-500 mb-5">
                        No beneficiaries yet.
                    </p>

                    <a
                        href="/client/beneficiaires/add"
                        class="inline-block px-5 py-3 bg-red-700 text-white rounded-lg font-semibold hover:bg-red-800 transition"
                    >
                        Add Beneficiary
                    </a>

                </div>

            <% } %>

        </div>

    </main>

</body>
</html>