<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HosBank - Mes bénéficiaires</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f5f5;
            color: #333;
        }

        /* HEADER */
        header {
            background: #b30000;
            color: white;
            padding: 20px 40px;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 24px;
        }

        .logout {
            background: white;
            color: #b30000;
            text-decoration: none;

            padding: 10px 18px;
            border-radius: 6px;

            font-weight: bold;
        }

        /* MAIN */
        main {
            padding: 40px;
            max-width: 1200px;
            margin: auto;
        }

        /* PAGE HEADER */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;

            margin-bottom: 30px;
        }

        .page-header h2 {
            color: #b30000;
            margin-bottom: 8px;
        }

        .page-header p {
            color: #666;
        }

        /* BUTTON */
        .add-button {
            background: #b30000;
            color: white;

            text-decoration: none;

            padding: 12px 18px;
            border-radius: 6px;

            font-weight: bold;
        }

        .add-button:hover {
            background: #8f0000;
        }

        /* BENEFICIARIES */
        .beneficiaries {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
        }

        .card {
            background: white;
            padding: 25px;

            border-radius: 10px;

            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
        }

        .card h3 {
            color: #b30000;
            margin-bottom: 20px;
        }

        /* BENEFICIARY */
        .beneficiary {
            padding: 15px 0;
            border-bottom: 1px solid #eee;
        }

        .beneficiary:last-child {
            border-bottom: none;
        }

        .beneficiary-name {
            font-weight: bold;
            font-size: 17px;
            margin-bottom: 5px;
        }

        .beneficiary-email {
            color: #777;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .beneficiary-rib {
            color: #555;
            font-size: 14px;
        }

        .beneficiary-rib strong {
            color: #333;
        }

        /* EMPTY */
        .empty {
            background: white;
            padding: 30px;

            border-radius: 10px;

            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);

            color: #888;
            text-align: center;
        }

        /* RESPONSIVE */
        @media (max-width: 700px) {

            main {
                padding: 20px;
            }

            header {
                padding: 20px;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 20px;
            }

            .beneficiaries {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <!-- HEADER -->
    <header>

        <h1>HosBank</h1>

        <a href="/auth/logout" class="logout">
            Logout
        </a>

    </header>


    <main>

        <!-- PAGE HEADER -->
        <div class="page-header">

            <div>
                <h2>
                    My Beneficiaries
                </h2>

                <p>
                    Manage the beneficiaries registered on your account.
                </p>
            </div>

            <a
                href="/client/beneficiaires/add"
                class="add-button"
            >
                + Add Beneficiary
            </a>

        </div>


        <!-- BENEFICIARIES LIST -->

        <% if (beneficiaires && beneficiaires.length > 0) { %>

            <div class="beneficiaries">

                <% beneficiaires.forEach(beneficiaire => { %>

                    <div class="card">

                        <h3>
                            Beneficiary
                        </h3>

                        <div class="beneficiary">

                            <div class="beneficiary-name">
                                <%= beneficiaire.prenom %>
                                <%= beneficiaire.nom %>
                            </div>

                            <div class="beneficiary-email">
                                <%= beneficiaire.email %>
                            </div>

                            <div class="beneficiary-rib">
                                <strong>RIB :</strong>
                                <%= beneficiaire.rib %>
                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } else { %>

            <!-- EMPTY -->

            <div class="empty">

                <p>
                    No beneficiaries yet.
                </p>

                <br>

                <a
                    href="/client/beneficiaires/add"
                    class="add-button"
                >
                    Add Beneficiary
                </a>

            </div>

        <% } %>


    </main>

</body>

</html>