<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HosBank - Dashboard</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-800">

    
    <%- include("../layouts/client-sidebar") %>


    
    <main class="ml-64 min-h-screen p-8">

        <div class="max-w-7xl mx-auto">

            <!-- HEADER -->
            <header class="flex items-center justify-between mb-8">

                <div>
                    <h1 class="text-3xl font-bold text-gray-800">
                        Dashboard
                    </h1>

                    <p class="text-gray-500 mt-1">
                        Overview of your bank account
                    </p>
                </div>

                <div class="text-sm text-gray-500">
                    HosBank
                </div>

            </header>


            <!-- WELCOME -->
            <div class="bg-white rounded-xl border border-gray-200 p-6 mb-8">

                <h2 class="text-xl font-semibold text-red-700 mb-2">
                    Welcome,
                    <%= user.prenom %>
                    <%= user.nom %>
                </h2>

                <p class="text-gray-500">
                    Here's an overview of your bank account.
                </p>

            </div>


            <!-- BALANCE + BENEFICIARIES -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">


                <!-- BALANCE -->
                <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">

                    <div class="flex items-center justify-between mb-6">

                        <h3 class="text-lg font-semibold text-gray-800">
                            My Balance
                        </h3>

                        <div class="w-10 h-10 rounded-lg bg-red-50 flex items-center justify-center text-red-700">
                            💰
                        </div>

                    </div>


                    <% if (balance && balance.length > 0) { %>

                        <% balance.forEach(compte => { %>

                            <div class="flex items-center justify-between py-4 border-b border-gray-100 last:border-b-0">

                                <div>

                                    <p class="text-sm text-gray-500">
                                        <%= compte.type %>
                                    </p>

                                    <p class="text-2xl font-bold text-red-700 mt-1">
                                        <%= compte.solde %> DH
                                    </p>

                                </div>

                            </div>

                        <% }) %>

                    <% } else { %>

                        <div class="py-6">

                            <p class="text-3xl font-bold text-gray-400">
                                0 DH
                            </p>

                            <p class="text-sm text-gray-500 mt-2">
                                No bank account available.
                            </p>

                        </div>

                    <% } %>

                </div>


                <!-- BENEFICIARIES -->
                <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">

                    <div class="flex items-center justify-between mb-6">

                        <h3 class="text-lg font-semibold text-gray-800">
                            My Beneficiaries
                        </h3>

                        <a href="/client/beneficiaires"
                           class="text-sm text-red-700 hover:text-red-900 font-medium">

                            View all

                        </a>

                    </div>


                    <% if (virements && virements.length > 0) { %>

                        <div class="space-y-4">

                            <% virements.forEach(virement => { %>

                                <div class="flex items-center gap-4 p-3 rounded-lg hover:bg-gray-50">

                                    <div class="w-10 h-10 rounded-full bg-red-100 text-red-700 flex items-center justify-center font-semibold">

                                        <%= virement.prenom.charAt(0).toUpperCase() %>

                                    </div>

                                    <div>

                                        <p class="font-medium text-gray-800">

                                            <%= virement.prenom %>
                                            <%= virement.nom %>

                                        </p>

                                        <p class="text-sm text-gray-500">

                                            <%= virement.email %>

                                        </p>

                                    </div>

                                </div>

                            <% }) %>

                        </div>

                    <% } else { %>

                        <div class="py-6 text-center">

                            <div class="text-4xl mb-3">
                                👥
                            </div>

                            <p class="text-gray-500">
                                No beneficiaries yet.
                            </p>

                            <a href="/client/beneficiaires/add"
                               class="inline-block mt-4 px-4 py-2 bg-red-700 text-white rounded-lg hover:bg-red-800 transition">

                                Add beneficiary

                            </a>

                        </div>

                    <% } %>

                </div>

            </div>


            <!-- RECENT ACTIVITIES -->
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">

                <div class="flex items-center justify-between mb-6">

                    <div>

                        <h3 class="text-lg font-semibold text-gray-800">
                            Recent Activities
                        </h3>

                        <p class="text-sm text-gray-500 mt-1">
                            Your latest banking operations
                        </p>

                    </div>

                    <a href="/client/historique"
                       class="text-sm text-red-700 hover:text-red-900 font-medium">

                        View history

                    </a>

                </div>


                <% if (activities && activities.length > 0) { %>

                    <div class="divide-y divide-gray-100">

                        <% activities.forEach(activity => { %>

                            <div class="flex items-center justify-between py-4">

                                <div class="flex items-center gap-4">

                                    <!-- ICON -->
                                    <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center">

                                        <% if (
                                            activity.type === "DEPOT" ||
                                            activity.type === "VIREMENT_RECU"
                                        ) { %>

                                            <span class="text-green-600">
                                                ↓
                                            </span>

                                        <% } else { %>

                                            <span class="text-red-600">
                                                ↑
                                            </span>

                                        <% } %>

                                    </div>


                                    <!-- INFO -->
                                    <div>

                                        <p class="font-medium text-gray-800">
                                            <%= activity.type %>
                                        </p>

                                        <p class="text-sm text-gray-500">

                                            <%= new Date(activity.date).toLocaleDateString("fr-FR") %>

                                        </p>

                                    </div>

                                </div>


                                <!-- AMOUNT -->
                                <div class="font-semibold text-gray-800">

                                    <%= activity.montant %> DH

                                </div>

                            </div>

                        <% }) %>

                    </div>

                <% } else { %>

                    <div class="py-10 text-center">

                        <div class="text-4xl mb-3">
                            ↺
                        </div>

                        <p class="text-gray-500">
                            No recent activities.
                        </p>

                    </div>

                <% } %>

            </div>

        </div>

    </main>

</body>

</html>