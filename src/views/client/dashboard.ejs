
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HosBank - Dashboard</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f5f5;
            color: #333;
        }

        /* HEADER */
        header {
            background: #b30000;
            color: white;
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 24px;
        }

        .logout {
            background: white;
            color: #b30000;
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 6px;
            font-weight: bold;
        }

        /* MAIN */
        main {
            padding: 40px;
            max-width: 1200px;
            margin: auto;
        }

        .welcome {
            margin-bottom: 30px;
        }

        .welcome h2 {
            color: #b30000;
            margin-bottom: 8px;
        }

        /* CARDS */
        .cards {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
            margin-bottom: 30px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
        }

        .card h3 {
            color: #b30000;
            margin-bottom: 20px;
        }

        /* BALANCE */
        .balance {
            font-size: 32px;
            font-weight: bold;
            color: #b30000;
        }

        .account {
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }

        /* ACTIVITIES */
        .activity {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 0;
            border-bottom: 1px solid #eee;
        }

        .activity:last-child {
            border-bottom: none;
        }

        .activity-type {
            font-weight: bold;
        }

        .activity-date {
            color: #888;
            font-size: 13px;
        }

        .activity-amount {
            font-weight: bold;
        }

        /* BENEFICIARIES */
        .beneficiary {
            padding: 15px 0;
            border-bottom: 1px solid #eee;
        }

        .beneficiary:last-child {
            border-bottom: none;
        }

        .beneficiary-name {
            font-weight: bold;
            margin-bottom: 5px;
        }

        .beneficiary-email {
            color: #777;
            font-size: 14px;
        }

        .request-button { padding: 10px 16px; background: #b30000; color: white; border: 0; border-radius: 6px; cursor: pointer; }
        .success { background: #e8f5e9; color: #216e39; padding: 12px 16px; border-radius: 6px; margin-bottom: 18px; }

        /* EMPTY */
        .empty {
            color: #888;
            padding: 10px 0;
        }

        /* RESPONSIVE */
        @media (max-width: 700px) {
            main {
                padding: 20px;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            header {
                padding: 20px;
            }
        }
    </style>
</head>

<body>

    <!-- HEADER -->
    <header>
        <h1>HosBank</h1>

        <a href="/auth/logout" class="logout">
            Logout
        </a>
    </header>


    <main>

        <!-- WELCOME -->
        <div class="welcome">
            <h2>
                Welcome, <%= user.prenom %> <%= user.nom %>
            </h2>

            <p>
                Here's an overview of your bank account.
            </p>
        </div>


        <!-- ACCOUNT + BENEFICIARIES -->
        <div class="cards">

            <!-- ACCOUNT -->
            <div class="card">
                <h3>Compte bancaire</h3>

                <% if (accounts && accounts.length > 0) { %>
                    <% accounts.forEach(compte => { %>
                        <div class="account">
                            <p><strong>Type : <%= compte.type %></strong></p>
                            <p>Statut : <%= compte.statut %></p>
                            <p>Solde : <%= compte.solde %> DH</p>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="empty">Vous n'avez pas encore de compte bancaire.</p>
                <% } %>

                <% if (accountRequests && accountRequests.length > 0) { %>
                    <h4>Demandes de compte bancaire</h4>
                    <% accountRequests.forEach(request => { %>
                        <div class="account">
                            <p><strong>Type : EPARGNE</strong></p>
                            <p>Statut : <strong><%= request.statut.replace(/_/g, ' ') %></strong></p>
                            <% if (request.statut === 'EN_ATTENTE') { %>
                                <p class="empty">Votre demande est en cours de traitement.</p>
                            <% } else if (request.statut === 'REFUSEE') { %>
                                <p class="empty">Votre demande a été refusée.</p>
                            <% } else if (request.statut === 'ACCEPTEE') { %>
                                <p class="empty">Votre demande a été acceptée.</p>
                            <% } %>
                        </div>
                    <% }) %>
                <% } %>
            </div>

            <!-- BENEFICIARIES -->
            <div class="card">

                <h3>My Beneficiaries</h3>

                <% if (virements && virements.length > 0) { %>

                    <% virements.forEach(virement => { %>

                        <div class="beneficiary">

                            <div class="beneficiary-name">
                                <%= virement.prenom %>
                                <%= virement.nom %>
                            </div>

                            <div class="beneficiary-email">
                                <%= virement.email %>
                            </div>

                        </div>

                    <% }) %>

                <% } else { %>

                    <p class="empty">
                        No beneficiaries yet.
                    </p>

                <% } %>

            </div>

        </div>

        <div class="card" style="margin-bottom: 30px;">
            <h3>Demander un compte bancaire</h3>
            <% if (accountRequestMessage) { %><p class="success"><%= accountRequestMessage %></p><% } %>
            <p class="empty">Les demandes de compte épargne sont examinées par un administrateur.</p>
            <form method="post" action="/client/demandes/comptes">
                <label for="account-type">Type de compte</label>
                <select id="account-type" name="type" required>
                    <option value="EPARGNE">Épargne</option>
                </select>
                <button class="request-button" type="submit">Demander un compte</button>
            </form>
        </div>

        <!-- RECENT ACTIVITIES -->
        <div class="card">

            <h3>Recent Activities</h3>
            <a href="/client/historique" style="display:inline-block;margin-bottom:14px;color:#b30000;font-weight:bold;text-decoration:none">Historique complet</a>

            <% if (activities && activities.length > 0) { %>

                <% activities.forEach(activity => { %>

                    <div class="activity">

                        <div>
                            <div class="activity-type">
                                <%= activity.type %>
                            </div>

                            <div class="activity-date">
                                <%= new Date(activity.date).toLocaleDateString("fr-FR") %>
                            </div>
                        </div>

                        <div class="activity-amount">
                            <%= activity.montant %> DH
                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <p class="empty">
                    No recent activities.
                </p>

            <% } %>

        </div>

    </main>

</body>
</html>

