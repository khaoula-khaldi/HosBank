<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Ajouter un bénéficiaire</title>
</head>

<body>

    <main>

        <h1>Ajouter un bénéficiaire</h1>

        <p>
            Ajoutez un bénéficiaire en renseignant son RIB.
        </p>

        <% if (typeof error !== "undefined" && error) { %>

            <div>
                <p><%= error %></p>
            </div>

        <% } %>


        <form action="/client/beneficiaires" method="POST">

            <div>
                <label for="rib">
                    RIB du bénéficiaire
                </label>

                <input
                    type="text"
                    id="rib"
                    name="rib"
                    placeholder="Entrez le RIB"
                    required
                >
            </div>


            <button type="submit">
                Ajouter
            </button>

        </form>

    </main>

</body>

</html>