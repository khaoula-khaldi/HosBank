<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HosBank - Réclamation</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-800">

    <%- include("../layouts/client-sidebar") %>

    <main class="ml-64 min-h-screen p-8">

        <div class="max-w-2xl mx-auto">

            <!-- Header -->
            <div class="mb-8">
                <h1 class="text-2xl font-bold text-red-700">
                    Déposer une réclamation
                </h1>

                <p class="text-gray-500 mt-2">
                    Signalez un problème ou une difficulté rencontrée avec votre compte.
                </p>
            </div>

            <!-- Card -->
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8">

                <!-- Error -->
                <% if (typeof error !== "undefined" && error) { %>

                    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                        <%= error %>
                    </div>

                <% } %>

                <form action="/client/reclamations" method="POST">

                    <!-- Sujet -->
                    <div class="mb-6">

                        <label
                            for="sujet"
                            class="block text-sm font-semibold text-gray-700 mb-2"
                        >
                            sujet
                        </label>

                        <input
                            type="text"
                            id="sujet"
                            name="sujet"
                            placeholder="Ex : Problème avec un virement"
                            required
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none focus:border-red-700 focus:ring-1 focus:ring-red-700"
                        >

                    </div>

                    <!-- Description -->
                    <div class="mb-6">

                        <label
                            for="description"
                            class="block text-sm font-semibold text-gray-700 mb-2"
                        >
                            Description
                        </label>

                        <textarea
                            id="description"
                            name="description"
                            rows="6"
                            placeholder="Décrivez votre problème..."
                            required
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none resize-none focus:border-red-700 focus:ring-1 focus:ring-red-700"
                        ></textarea>

                    </div>

                    <!-- Information -->
                    <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-6">

                        <div class="flex gap-3">

                            <span class="text-lg">ℹ️</span>

                            <p class="text-sm text-gray-600">
                                Votre réclamation sera enregistrée avec le statut
                                <strong>EN ATTENTE</strong> et pourra ensuite être traitée
                                par un chargé client.
                            </p>

                        </div>

                    </div>

                    <!-- Buttons -->
                    <div class="flex gap-3">

                        <a
                            href="/client/dashboard"
                            class="flex-1 text-center px-6 py-3 bg-gray-100 text-gray-700 rounded-lg font-semibold hover:bg-gray-200 transition"
                        >
                            Annuler
                        </a>

                        <button
                            type="submit"
                            class="flex-1 px-6 py-3 bg-red-700 text-white rounded-lg font-semibold hover:bg-red-800 transition"
                        >
                            Envoyer
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </main>

</body>

</html>