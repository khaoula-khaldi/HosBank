<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HosBank - Virement</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-800">

    <!-- Sidebar -->
    <%- include("../layouts/client-sidebar") %>


    <!-- Main -->
    <main class="ml-64 min-h-screen p-8">

        <div class="max-w-2xl mx-auto">

            <!-- Header -->
            <div class="mb-6">

                <h1 class="text-2xl font-bold text-gray-800">
                    Faire un virement
                </h1>

                <p class="text-gray-500 mt-2">
                    Sélectionnez un bénéficiaire et indiquez le montant.
                </p>

            </div>


            <!-- Card -->
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8">

                <!-- Error -->
                <% if (error) { %>

                    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                        <%= error %>
                    </div>

                <% } %>


                <!-- Aucun bénéficiaire -->
                <% if (!beneficiaires || beneficiaires.length === 0) { %>

                    <div class="text-center py-8">

                        <div class="text-5xl mb-4">
                            👥
                        </div>

                        <p class="text-gray-500">
                            Vous n'avez aucun bénéficiaire.
                        </p>

                        <a
                            href="/client/beneficiaires/add"
                            class="inline-block mt-5 px-5 py-3 bg-red-700 text-white rounded-lg font-semibold hover:bg-red-800 transition"
                        >
                            Ajouter un bénéficiaire
                        </a>

                    </div>


                <% } else { %>


                    <!-- Formulaire -->
                    <form
                        action="/client/virement"
                        method="POST"
                    >

                        <!-- Bénéficiaire -->
                        <div class="mb-6">

                            <label
                                for="beneficiaireId"
                                class="block text-sm font-semibold text-gray-700 mb-2"
                            >
                                Bénéficiaire
                            </label>

                            <select
                                id="beneficiaireId"
                                name="beneficiaireId"
                                required
                                class="w-full px-4 py-3 bg-white border border-gray-300 rounded-lg outline-none focus:border-red-700 focus:ring-1 focus:ring-red-700"
                            >

                                <option value="">
                                    -- Sélectionner un bénéficiaire --
                                </option>

                                <% beneficiaires.forEach(beneficiaire => { %>

                                    <option
                                        value="<%= beneficiaire.beneficiaire_id %>"
                                    >
                                        <%= beneficiaire.rib %>
                                    </option>

                                <% }) %>

                            </select>

                        </div>


                        <!-- Montant -->
                        <div class="mb-6">

                            <label
                                for="montant"
                                class="block text-sm font-semibold text-gray-700 mb-2"
                            >
                                Montant
                            </label>

                            <div class="relative">

                                <input
                                    type="number"
                                    id="montant"
                                    name="montant"
                                    min="0.01"
                                    step="0.01"
                                    placeholder="Ex : 500"
                                    required
                                    class="w-full px-4 py-3 pr-16 border border-gray-300 rounded-lg outline-none focus:border-red-700 focus:ring-1 focus:ring-red-700"
                                >

                                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 font-medium">
                                    DH
                                </span>

                            </div>

                        </div>


                        <!-- Submit -->
                        <button
                            type="submit"
                            class="w-full py-3 bg-red-700 text-white rounded-lg font-semibold hover:bg-red-800 transition"
                        >
                            Faire le virement
                        </button>


                        <!-- Cancel -->
                        <a
                            href="/client/dashboard"
                            class="block text-center mt-4 text-gray-500 hover:text-gray-700 transition"
                        >
                            Annuler
                        </a>

                    </form>

                <% } %>

            </div>

        </div>

    </main>

</body>
</html>