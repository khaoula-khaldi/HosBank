<!DOCTYPE html>

<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="/css/main.css" rel="stylesheet">

    <title>HosBank - Inscription</title>
</head>

<body class="min-h-screen bg-gray-100 flex items-center justify-center">

    <div class="w-full max-w-md px-6">

        <div class="bg-white rounded-2xl shadow-lg px-8 py-10">

            <!-- Title -->
            <h1 class="text-3xl font-serif text-center text-gray-800 mb-8">
                Sign up
            </h1>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                    <%= error %>
                </div>
            <% } %>

            <form action="/auth/register" method="POST" class="space-y-5">

                <!-- Nom -->
                <div>
                    <label
                        for="nom"
                        class="block text-sm font-medium text-gray-700 mb-2"
                    >
                        Nom
                    </label>

                    <input
                        type="text"
                        id="nom"
                        name="nom"
                        placeholder="Full name"
                        required
                        class="w-full px-4 py-3 rounded-lg border border-gray-200
                               shadow-sm outline-none
                               focus:border-red-500 focus:ring-2 focus:ring-red-100"
                    >
                </div>

                <!-- Prénom -->
                <div>
                    <label
                        for="prenom"
                        class="block text-sm font-medium text-gray-700 mb-2"
                    >
                        Prénom
                    </label>

                    <input
                        type="text"
                        id="prenom"
                        name="prenom"
                        placeholder="First name"
                        required
                        class="w-full px-4 py-3 rounded-lg border border-gray-200
                               shadow-sm outline-none
                               focus:border-red-500 focus:ring-2 focus:ring-red-100"
                    >
                </div>

                <!-- Email -->
                <div>
                    <label
                        for="email"
                        class="block text-sm font-medium text-gray-700 mb-2"
                    >
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="your email"
                        required
                        class="w-full px-4 py-3 rounded-lg border border-gray-200
                               shadow-sm outline-none
                               focus:border-red-500 focus:ring-2 focus:ring-red-100"
                    >
                </div>

                <!-- Password -->
                <div>
                    <label
                        for="password"
                        class="block text-sm font-medium text-gray-700 mb-2"
                    >
                        Mot de passe
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="your password"
                        required
                        class="w-full px-4 py-3 rounded-lg border border-gray-200
                               shadow-sm outline-none
                               focus:border-red-500 focus:ring-2 focus:ring-red-100"
                    >
                </div>

                <!-- Button -->
                <button
                    type="submit"
                    class="w-full bg-red-600 text-white py-3 rounded-lg
                           font-medium shadow-sm
                           hover:bg-red-700 transition duration-200"
                >
                    Sign up
                </button>

            </form>

            <!-- Login link -->
            <p class="text-center text-sm text-gray-500 mt-6">
                Vous avez déjà un compte ?
                <a
                    href="/auth/login"
                    class="text-red-600 font-medium hover:underline"
                >
                    Se connecter
                </a>
            </p>

        </div>

    </div>

</body>
</html>
