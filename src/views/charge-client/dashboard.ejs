<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HOSBank - Chargé Client Dashboard</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: Arial, sans-serif; }
        body { background: #f5f5f5; color: #333; }
        header { background: #0056b3; color: white; padding: 20px 40px; display: flex; justify-content: space-between; align-items: center; }
        header h1 { font-size: 24px; }
        .logout { background: white; color: #0056b3; text-decoration: none; padding: 10px 18px; border-radius: 6px; font-weight: bold; }
        main { padding: 40px; max-width: 1000px; margin: auto; }
        .section-title { color: #0056b3; margin-bottom: 20px; font-size: 20px; border-bottom: 2px solid #0056b3; padding-bottom: 5px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 40px; }
        .card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); text-align: center; }
        .card h3 { font-size: 14px; color: #666; margin-bottom: 10px; text-transform: uppercase; }
        .card .value { font-size: 28px; font-weight: bold; color: #333; }
    </style>
</head>
<body>
    <header>
        <h1>HOSBank - Chargé Client Dashboard</h1>
        <a href="/auth/logout" class="logout">Logout</a>
    </header>

    <main>
        <h2 class="section-title">Clients</h2>
        <div class="grid">
            <div class="card">
                <h3>Total</h3>
                <div class="value"><%= stats.clients.total %></div>
            </div>
            <div class="card">
                <h3>Actifs</h3>
                <div class="value"><%= stats.clients.active %></div>
            </div>
            <div class="card">
                <h3>Inactifs</h3>
                <div class="value"><%= stats.clients.inactive %></div>
            </div>
        </div>

        <h2 class="section-title">Comptes Bancaires</h2>
        <div class="grid">
            <div class="card">
                <h3>Total</h3>
                <div class="value"><%= stats.comptes.total %></div>
            </div>
            <div class="card">
                <h3>Actifs</h3>
                <div class="value"><%= stats.comptes.active %></div>
            </div>
            <div class="card">
                <h3>Bloqués</h3>
                <div class="value"><%= stats.comptes.blocked %></div>
            </div>
            <div class="card">
                <h3>Inactifs</h3>
                <div class="value"><%= stats.comptes.inactive %></div>
            </div>
        </div>

        <h2 class="section-title">Requêtes Clients</h2>
        <div class="grid">
            <div class="card">
                <h3>Demandes Total</h3>
                <div class="value"><%= stats.demandes.total %></div>
            </div>
            <div class="card">
                <h3>Demandes En Attente</h3>
                <div class="value"><%= stats.demandes.pending %></div>
            </div>
            <div class="card">
                <h3>Réclamations Total</h3>
                <div class="value"><%= stats.reclamations.total %></div>
            </div>
            <div class="card">
                <h3>Réclamations En Attente / En Cours</h3>
                <div class="value"><%= stats.reclamations.pending %></div>
            </div>
        </div>

        <h2 class="section-title">Virements</h2>
        <div class="grid">
            <div class="card">
                <h3>Total</h3>
                <div class="value"><%= stats.virements.total %></div>
            </div>
            <div class="card">
                <h3>En Attente</h3>
                <div class="value"><%= stats.virements.en_attente %></div>
            </div>
            <div class="card">
                <h3>Exécutés</h3>
                <div class="value"><%= stats.virements.execute %></div>
            </div>
            <div class="card">
                <h3>Refusés</h3>
                <div class="value"><%= stats.virements.refuse %></div>
            </div>
            <div class="card">
                <h3>Annulés</h3>
                <div class="value"><%= stats.virements.annule %></div>
            </div>
        </div>
    </main>
</body>
</html>
