<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HosBank - Bienvenue</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 min-h-screen">

    <div class="min-h-screen flex items-center justify-center px-6">

        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 
                    max-w-5xl w-full overflow-hidden">

            <div class="grid md:grid-cols-2">

                <!-- Partie gauche -->
                <div class="bg-red-700 text-white p-10 md:p-14 
                            flex flex-col justify-center">

                    <div class="flex items-center gap-3 mb-10">
                        <div class="w-12 h-12 bg-white text-red-700 rounded-xl 
                                    flex items-center justify-center text-xl font-bold">
                            H
                        </div>

                        <h1 class="text-2xl font-bold">
                            HosBank
                        </h1>
                    </div>

                    <h2 class="text-4xl font-bold leading-tight mb-5">
                        Bienvenue dans votre espace bancaire
                    </h2>

                    <p class="text-red-100 text-lg">
                        Gérez vos comptes, vos virements et vos opérations
                        bancaires simplement et en toute sécurité.
                    </p>
                </div>


                <!-- Partie droite -->
                <div class="p-10 md:p-14 flex flex-col justify-center">

                    <h2 class="text-3xl font-bold text-gray-800 mb-3">
                        Bienvenue !
                    </h2>

                    <p class="text-gray-500 mb-8">
                        Connectez-vous à votre espace client ou créez
                        votre compte pour commencer.
                    </p>

                    <div class="flex flex-col gap-4">

                        <a href="/auth/login"
                           class="w-full text-center bg-red-700 text-white 
                                  py-3 rounded-lg font-semibold 
                                  hover:bg-red-800 transition">
                            Se connecter
                        </a>

                        <a href="/auth/register"
                           class="w-full text-center border border-red-700 
                                  text-red-700 py-3 rounded-lg font-semibold 
                                  hover:bg-red-50 transition">
                            Créer un compte
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</body>
</html>