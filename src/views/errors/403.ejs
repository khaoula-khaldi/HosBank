<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Accès Refusé</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 h-screen flex items-center justify-center">
    <div class="bg-white p-10 rounded-lg shadow-xl text-center max-w-lg">
        <h1 class="text-6xl font-bold text-red-500 mb-4">403</h1>
        <h2 class="text-2xl font-semibold mb-2">Accès Non Autorisé</h2>
        <p class="text-gray-600 mb-6">
            Désolé <%= user.prenom %>, votre rôle actuel (<span class="font-bold text-red-600"><%= user.role %></span>) ne vous permet pas d'accéder à cette ressource.
        </p>
        <a href="javascript:history.back()" class="inline-block bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-600 transition">
            Retourner en arrière
        </a>
    </div>
</body>
</html>
